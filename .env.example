# InveX AI Backend — environment template
#
# Copy this file to `.env` and adjust values for your environment.
#   cp .env.example .env
#
# Never commit your real `.env` (it is gitignored).  The values below are
# local-development defaults only — they contain NO production credentials.

APP_NAME=InveX AI Backend
APP_VERSION=1.0.0

# Runtime environment: "development" or "production".
# When ENVIRONMENT=production the application REFUSES to start if
# SECRET_KEY is left at its insecure default.
ENVIRONMENT=development
# Set DEBUG=true only in local development.  Never enable in production.
DEBUG=false

# Local PostgreSQL connection.  The default has no embedded password;
# set the password via the URL (or an injectable secret) in production.
DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/invex
DATABASE_ECHO=false

# JWT signing key.  MUST be a long, random, non-default value when
# ENVIRONMENT=production (startup validation enforces this).
SECRET_KEY=CHANGE_ME_IN_PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

CORS_ORIGINS=["http://localhost:3000","https://*.vercel.app"]

PREDICTRON_ENGINE_URL=http://localhost:8001
# API key for the external engine (unused when the engine is embedded).
PREDICTRON_API_KEY=

API_V1_PREFIX=/api/v1

# --- Rate limiting ----------------------------------------------------
# In-memory sliding-window limiter.  It is per-process, NOT distributed.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
# List of trusted proxy IPs/CIDRs that sit directly in front of the app.
# When non-empty, X-Forwarded-For is only honoured when the socket peer is
# one of these proxies.  Keep empty if the app is not behind a proxy.
RATE_LIMIT_TRUSTED_PROXIES=[]
# Upper bound on distinct tracked client keys (bounds memory).
RATE_LIMIT_MAX_TRACKED_CLIENTS=100000

REQUEST_ID_HEADER=X-Request-ID

# --- Evidence collection ---------------------------------------------
# Opt-in search-backed discovery (requires TAVILY_API_KEY).
EVIDENCE_SEARCH_ENABLED=false
TAVILY_API_KEY=